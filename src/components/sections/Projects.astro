---
import { ArrowUpRight } from 'lucide-react';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import BrandIcon from '@/components/ui/BrandIcon.astro';
import { projects, socials } from '@/data/portfolio';

interface Props {
  index: string;
}
const { index } = Astro.props;

const github = socials.find((s) => s.id === 'github');
const featured = projects.find((p) => p.featured) ?? projects[0];
const rest = projects.filter((p) => p !== featured);

/**
 * Bento rhythm for the remaining projects: 7/5 split, then 8 + GitHub card.
 * Extra projects keep cycling through the pattern.
 */
const pattern = [
  { span: 'lg:col-span-7', variant: 'stacked' },
  { span: 'lg:col-span-5', variant: 'stacked' },
  { span: 'lg:col-span-8', variant: 'horizontal' },
] as const;
const layout = rest.map((project, i) => ({ project, ...pattern[i % pattern.length] }));
const lastIsHorizontal = layout.at(-1)?.variant === 'horizontal';
---

<section id="work" class="section-y relative" aria-labelledby="work-title" data-nav-section="work">
  <div class="container-x">
    <SectionHeading index={index} label="Selected work" id="work-title" title="Selected" accent="work" align="split">
      Infrastructure and the products that run on it — from a Docker Compose deployment to a mentorship platform on
      AWS.
    </SectionHeading>

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-12 lg:gap-6">
      {featured && <ProjectCard project={featured} index={1} variant="feature" class="md:col-span-2 lg:col-span-12" />}
      {
        layout.map(({ project, span, variant }, i) => (
          <ProjectCard
            project={project}
            index={i + 2}
            variant={variant}
            class:list={[span, variant === 'horizontal' && 'md:col-span-2']}
          />
        ))
      }
      {
        github && (
          <a
            href={github.href}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'github-card group relative flex flex-col justify-between overflow-hidden rounded-[var(--radius-lg)] bg-[var(--color-ink)] p-8 text-white md:col-span-2',
              lastIsHorizontal ? 'lg:col-span-4' : 'lg:col-span-12',
            ]}
            data-reveal
          >
            <div class="bg-grid-dark pointer-events-none absolute inset-0 opacity-70" aria-hidden="true" />
            <div class="relative flex items-center justify-between">
              <BrandIcon name="github" size={28} />
              <span class="gh-arrow inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/25">
                <ArrowUpRight size={18} aria-hidden="true" />
              </span>
            </div>
            <div class="relative mt-16">
              <p class="label text-[var(--color-mist)]">{github.handle}</p>
              <p class="mt-3 font-display text-3xl leading-tight font-semibold tracking-tight">
                More code <span class="serif-accent text-[#9aa5ff]">on GitHub</span>
              </p>
              <p class="mt-3 text-sm text-[var(--color-mist)]">
                Repositories, experiments and work in progress.
                <span class="sr-only">(opens in a new tab)</span>
              </p>
            </div>
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .github-card {
    min-height: 18rem;
    transition: transform 0.6s var(--ease-out-expo);
  }
  .gh-arrow {
    transition:
      transform 0.5s var(--ease-out-expo),
      background-color 0.3s,
      color 0.3s;
  }
  .github-card:hover .gh-arrow {
    transform: rotate(45deg);
    background: #fff;
    color: var(--color-ink);
  }
</style>
