---
/**
 * Professional highlights — every value is derived from portfolio.ts so the
 * strip never shows a number that isn't backed by real data.
 */
import { achievements, education, experience, projects, skillGroups } from '@/data/portfolio';
import { pad } from '@/utils/text';

const award = achievements.find((a) => a.kind === 'award');
const certInProgress = achievements.find((a) => a.kind === 'certification' && a.status === 'in-progress');
const degree = education[0];
const gradYear = degree?.period.match(/(\d{4})\s*$/)?.[1];

type Item = { value: string; label: string; detail: string };
const items: Item[] = [
  award && { value: '1st', label: award.title, detail: award.issuer },
  experience.length > 0 && {
    value: pad(experience.length),
    label: experience.length === 1 ? 'Internship' : 'Internships',
    detail: experience.map((e) => e.organization).join(' · '),
  },
  projects.length > 0 && {
    value: pad(projects.length),
    label: 'Featured projects',
    detail: 'DevOps, cloud & full-stack',
  },
  certInProgress && {
    value: certInProgress.title.match(/\(([^)]+)\)/)?.[1] ?? 'AWS',
    label: 'In progress',
    detail: certInProgress.title.replace(/\s*\([^)]+\)/, ''),
  },
  degree &&
    gradYear && {
      value: gradYear,
      label: 'Expected graduation',
      detail: `${degree.degree} · ${degree.shortName ?? degree.institution}`,
    },
].filter(Boolean) as Item[];

const marquee = skillGroups.flatMap((g) => g.skills.map((s) => s.name));
---

<section id="highlights" class="relative border-y border-[var(--color-line)] bg-[var(--color-surface)]" aria-label="Highlights">
  <div class="container-x">
    <!-- gap-px over a line-coloured background draws hairline dividers at every breakpoint -->
    <dl class="-mx-[var(--gutter)] grid grid-cols-2 gap-px bg-[var(--color-line)] md:grid-cols-6 lg:mx-0 lg:grid-cols-5">
      {
        items.map((item, i) => (
          <div
            class:list={[
              'highlight relative flex flex-col gap-3 bg-[var(--color-surface)] px-[var(--gutter)] py-8 md:col-span-2 lg:col-span-1 lg:px-8 lg:py-10 lg:first:pl-0',
              // Last item fills leftover space in the 2- and 3-column layouts.
              items.length % 2 === 1 && i === items.length - 1 && 'max-md:col-span-2',
              items.length % 3 === 2 && i >= items.length - 2 && 'md:max-lg:col-span-3',
            ]}
            data-reveal
            data-reveal-delay={String(i * 70)}
          >
            <dt class="order-2">
              <span class="block text-sm font-semibold tracking-tight">{item.label}</span>
              <span class="mt-1 block text-sm leading-snug text-[var(--color-ink-3)]">{item.detail}</span>
            </dt>
            <dd
              class:list={[
                'order-1 flex h-[clamp(2.4rem,4.4vw,3.6rem)] items-end font-display leading-none font-semibold tracking-[-0.045em] whitespace-nowrap',
                // Long values (e.g. "SAA-C03") scale down so they never wrap.
                item.value.length > 4 ? 'text-[clamp(1.7rem,2.7vw,2.5rem)]' : 'text-[clamp(2.4rem,4.4vw,3.6rem)]',
              ]}
            >
              {item.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>

  <!-- Ambient tech ticker (decorative; the same list is in the Skills section) -->
  <div class="marquee relative overflow-hidden border-t border-[var(--color-line)] py-4" aria-hidden="true">
    <div class="flex w-max animate-marquee">
      {
        [0, 1].map(() => (
          <ul class="flex shrink-0 items-center">
            {marquee.map((name) => (
              <li class="flex items-center">
                <span class="px-6 font-display text-xl font-medium tracking-tight text-[var(--color-ink-2)]">
                  {name}
                </span>
                <svg width="10" height="10" viewBox="0 0 10 10" class="text-[var(--color-accent)]">
                  <rect x="1" y="1" width="8" height="8" rx="2" fill="none" stroke="currentColor" stroke-width="1.4" />
                </svg>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  .marquee {
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee:hover .animate-marquee {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee .animate-marquee {
      animation: none !important;
    }
  }
</style>
