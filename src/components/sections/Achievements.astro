---
import { Award, BadgeCheck, GraduationCap, ArrowUpRight, Wrench } from 'lucide-react';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { achievements, type Achievement } from '@/data/portfolio';

interface Props {
  index: string;
}
const { index } = Astro.props;

const KIND: Record<Achievement['kind'], { label: string; icon: typeof Award }> = {
  award: { label: 'Award', icon: Award },
  certification: { label: 'Certification', icon: BadgeCheck },
  training: { label: 'Training', icon: Wrench },
  academic: { label: 'Academic', icon: GraduationCap },
};

// The first award (if any) gets the large feature tile; everything else sits in the grid.
const lead = achievements.find((a) => a.kind === 'award');
const others = achievements.filter((a) => a !== lead);
// "1st Position Holder" → ["1", "st"] for the oversized numeral.
const numeral = lead?.title.match(/^(\d+)(st|nd|rd|th)\b/i);
---

{
  achievements.length > 0 && (
    <section
      id="achievements"
      class="section-y relative bg-[var(--color-surface)]"
      aria-labelledby="achievements-title"
      data-nav-section="experience"
    >
      <div class="container-x">
        <SectionHeading index={index} label="Achievements & certifications" id="achievements-title" title="Recognition" accent="& receipts" align="split">
          Verified milestones only — awards, training and certifications, with in-progress items marked as such.
        </SectionHeading>

        <div class="grid gap-5 lg:grid-cols-12">
          {lead && (
            <article
              class="award-card on-accent relative overflow-hidden rounded-[var(--radius-lg)] p-8 text-white lg:col-span-5 lg:p-10"
              data-reveal
            >
              <div class="award-glow pointer-events-none absolute inset-0" aria-hidden="true" />
              <div class="relative flex h-full min-h-[22rem] flex-col">
                <p class="label flex items-center gap-2 text-white/75">
                  <Award size={14} aria-hidden="true" /> {KIND[lead.kind].label}
                  {lead.date && <span>· {lead.date}</span>}
                </p>
                {numeral ? (
                  <p class="award-numeral mt-auto font-display font-bold" aria-hidden="true">
                    {numeral[1]}
                    <span class="ml-[0.16em] inline-block align-top text-[0.32em] tracking-normal">{numeral[2]}</span>
                  </p>
                ) : (
                  <div class="mt-auto" />
                )}
                <h3 class="text-3xl font-semibold md:text-4xl">{lead.title}</h3>
                <p class="mt-2 text-white/80">{lead.issuer}</p>
                {lead.detail && <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/70">{lead.detail}</p>}
                {lead.credentialUrl && (
                  <a href={lead.credentialUrl} target="_blank" rel="noopener noreferrer" class="link-underline mt-5 inline-flex items-center gap-1.5 self-start text-sm">
                    View credential <ArrowUpRight size={14} aria-hidden="true" />
                  </a>
                )}
              </div>
            </article>
          )}

          <div class:list={['grid gap-5 sm:grid-cols-2', lead ? 'lg:col-span-7' : 'lg:col-span-12 lg:grid-cols-3']}>
          {others.map((item, i) => {
            const Icon = KIND[item.kind].icon;
            const inProgress = item.status === 'in-progress';
            return (
              <article
                class:list={[
                  'cert-card group relative flex flex-col rounded-[var(--radius-lg)] border bg-[var(--color-paper)] p-6 md:p-7',
                  inProgress ? 'cert-card--progress border-dashed border-[var(--color-accent)]' : 'border-[var(--color-line)]',
                ]}
                data-reveal
                data-reveal-delay={String((i + 1) * 70)}
              >
                <div class="flex items-center justify-between gap-3">
                  <span
                    class:list={[
                      'inline-flex h-10 w-10 items-center justify-center rounded-xl',
                      inProgress ? 'bg-[var(--color-accent)] text-white' : 'bg-[var(--color-surface)] text-[var(--color-ink)] ring-1 ring-[var(--color-line)]',
                    ]}
                  >
                    <Icon size={18} aria-hidden="true" />
                  </span>
                  <span
                    class:list={[
                      'label rounded-full px-2.5 py-1',
                      inProgress ? 'bg-[var(--color-accent-soft)] text-[var(--color-accent-deep)]' : 'text-[var(--color-ink-3)]',
                    ]}
                  >
                    {inProgress ? 'In progress' : KIND[item.kind].label}
                  </span>
                </div>
                <h3 class="mt-8 text-xl leading-tight font-semibold md:text-2xl">{item.title}</h3>
                <p class="mt-2 text-[var(--color-ink-2)]">{item.issuer}</p>
                {item.detail && <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-3)]">{item.detail}</p>}
                <div class="mt-auto flex items-center justify-between gap-3 pt-6">
                  {item.date && <span class="label text-[var(--color-ink-3)]">{item.date}</span>}
                  {item.credentialUrl && (
                    <a
                      href={item.credentialUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link-underline inline-flex items-center gap-1 text-sm font-medium"
                    >
                      Credential <ArrowUpRight size={14} aria-hidden="true" />
                      <span class="sr-only"> for {item.title} (opens in a new tab)</span>
                    </a>
                  )}
                </div>
              </article>
            );
          })}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .award-card {
    background: linear-gradient(155deg, #3243ff 0%, #2b3dff 40%, #1b28c4 100%);
  }
  .award-glow {
    background:
      radial-gradient(60% 50% at 85% 10%, rgb(255 255 255 / 0.22), transparent 70%),
      radial-gradient(50% 40% at 0% 100%, rgb(255 90 31 / 0.35), transparent 70%);
  }
  .award-numeral {
    font-size: clamp(7rem, 16vw, 12rem);
    line-height: 0.8;
    letter-spacing: -0.07em;
    margin-bottom: 1.5rem;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(255 255 255 / 0.85);
  }
  .cert-card {
    transition:
      transform 0.6s var(--ease-out-expo),
      border-color 0.3s,
      box-shadow 0.6s var(--ease-out-expo);
  }
  .cert-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 30px 50px -35px rgb(12 14 19 / 0.4);
  }
  .cert-card--progress {
    background:
      repeating-linear-gradient(-45deg, rgb(43 61 255 / 0.04) 0 10px, transparent 10px 20px),
      var(--color-paper);
  }
</style>
