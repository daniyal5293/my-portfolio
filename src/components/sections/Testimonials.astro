---
/**
 * Testimonials — renders nothing until real entries are added to
 * `testimonials` in src/data/portfolio.ts. Never add invented quotes.
 */
import { ArrowUpRight } from 'lucide-react';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { testimonials } from '@/data/portfolio';

interface Props {
  index: string;
}
const { index } = Astro.props;
---

{
  testimonials.length > 0 && (
    <section id="testimonials" class="section-y relative" aria-labelledby="testimonials-title">
      <div class="container-x">
        <SectionHeading index={index} label="Testimonials" id="testimonials-title" title="In their" accent="words" />
        <div class="grid gap-5 md:grid-cols-2">
          {testimonials.map((t, i) => (
            <figure
              class:list={[
                'flex flex-col rounded-[var(--radius-lg)] border border-[var(--color-line)] bg-[var(--color-surface)] p-8 md:p-10',
                testimonials.length % 2 === 1 && i === 0 && 'md:col-span-2',
              ]}
              data-reveal
              data-reveal-delay={String(i * 80)}
            >
              <span class="serif-accent text-6xl leading-none text-[var(--color-accent)]" aria-hidden="true">
                “
              </span>
              <blockquote class="mt-2 font-display text-xl leading-snug font-medium tracking-tight md:text-2xl">
                {t.quote}
              </blockquote>
              <figcaption class="mt-8 flex items-end justify-between gap-4 border-t border-[var(--color-line)] pt-5">
                <span>
                  <span class="block font-semibold">{t.name}</span>
                  <span class="block text-sm text-[var(--color-ink-3)]">
                    {t.role}, {t.organization}
                  </span>
                </span>
                {t.source && (
                  <a href={t.source} target="_blank" rel="noopener noreferrer" class="label inline-flex items-center gap-1 text-[var(--color-ink-2)] hover:text-[var(--color-accent)]">
                    Source <ArrowUpRight size={12} aria-hidden="true" />
                    <span class="sr-only"> for the recommendation from {t.name} (opens in a new tab)</span>
                  </a>
                )}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}
