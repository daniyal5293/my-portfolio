---
/**
 * Project card with layout variants so the grid never feels repetitive.
 *  feature    — full-width, preview and copy side by side
 *  stacked    — preview on top, copy below
 *  horizontal — copy left, preview right (reverse of feature, smaller)
 * The whole card links to the case study (stretched link); external links sit
 * above it so there are no nested anchors.
 */
import { ArrowUpRight } from 'lucide-react';
import BrandIcon from '@/components/ui/BrandIcon.astro';
import ProjectPreview from './ProjectPreview.astro';
import type { Project } from '@/data/portfolio';
import { pad } from '@/utils/text';

interface Props {
  project: Project;
  index: number;
  variant?: 'feature' | 'stacked' | 'horizontal';
  class?: string;
}

const { project, index, variant = 'stacked', class: className } = Astro.props;
const href = `/projects/${project.slug}/`;
const maxChips = variant === 'feature' ? 9 : 5;
const extraChips = project.stack.length - maxChips;
---

<!-- Reveal lives on the wrapper so it doesn't fight the card's tilt transform -->
<div class:list={['flex', className]} data-reveal>
<article
  class:list={['project-card group relative isolate flex w-full overflow-hidden', `project-card--${variant}`]}
  data-spotlight="5"
  aria-labelledby={`project-${project.slug}`}
>
  <div class="card-shine pointer-events-none absolute inset-0 z-20" aria-hidden="true"></div>

  <div class="card-media relative overflow-hidden">
    <ProjectPreview project={project} />
  </div>

  <div class="card-body relative flex flex-col p-6 md:p-8">
    <div class="flex items-center justify-between gap-4">
      <p class="label text-[var(--color-ink-3)]">
        <span class="text-[var(--color-accent)]">P/{pad(index)}</span> — {project.category}
      </p>
      {project.year && <p class="label text-[var(--color-ink-3)]">{project.year}</p>}
    </div>

    <h3
      id={`project-${project.slug}`}
      class:list={[
        'mt-5 font-semibold',
        variant === 'feature' ? 'text-[clamp(2.4rem,5vw,4.5rem)] leading-[0.95]' : 'text-[clamp(1.8rem,3vw,2.5rem)] leading-none',
      ]}
    >
      <a href={href} class="stretched-link outline-none">
        {project.title}
      </a>
    </h3>

    <p class="serif-accent mt-3 text-xl text-[var(--color-ink-2)] md:text-2xl">{project.tagline}</p>
    <p class="mt-4 max-w-[38rem] leading-relaxed text-[var(--color-ink-2)]">{project.summary}</p>

    <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Technologies">
      {project.stack.slice(0, maxChips).map((tech) => <li class="chip">{tech}</li>)}
      {extraChips > 0 && <li class="chip">+{extraChips} more</li>}
    </ul>

    <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-3 pt-8">
      <span class="case-cta inline-flex items-center gap-2 font-medium" aria-hidden="true">
        View case study
        <span class="case-arrow inline-flex h-8 w-8 items-center justify-center rounded-full">
          <ArrowUpRight size={16} />
        </span>
      </span>
      {
        project.links.github && (
          <a
            href={project.links.github}
            target="_blank"
            rel="noopener noreferrer"
            class="ext-link relative z-30 inline-flex items-center gap-1.5 text-sm text-[var(--color-ink-2)] hover:text-[var(--color-ink)]"
          >
            <BrandIcon name="github" size={15} />
            <span class="link-underline">Source</span>
            <span class="sr-only"> for {project.title} (opens in a new tab)</span>
          </a>
        )
      }
      {
        project.links.live && (
          <a
            href={project.links.live}
            target="_blank"
            rel="noopener noreferrer"
            class="ext-link relative z-30 inline-flex items-center gap-1.5 text-sm text-[var(--color-ink-2)] hover:text-[var(--color-ink)]"
          >
            <ArrowUpRight size={15} aria-hidden="true" />
            <span class="link-underline">Live demo</span>
            <span class="sr-only"> of {project.title} (opens in a new tab)</span>
          </a>
        )
      }
    </div>
  </div>
</article>
</div>

<style>
  .project-card {
    flex-direction: column;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    transform: perspective(1200px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition:
      transform 0.7s var(--ease-out-expo),
      box-shadow 0.7s var(--ease-out-expo),
      border-color 0.4s;
  }
  .project-card:hover,
  .project-card:focus-within {
    border-color: var(--color-line-strong);
    box-shadow: 0 40px 80px -40px rgb(12 14 19 / 0.35);
  }
  .project-card:focus-within {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .card-shine {
    background: radial-gradient(
      420px circle at var(--mx, 50%) var(--my, 0%),
      rgb(255 255 255 / 0.5),
      transparent 45%
    );
    opacity: 0;
    transition: opacity 0.4s;
    mix-blend-mode: soft-light;
  }
  .project-card:hover .card-shine {
    opacity: 1;
  }

  .card-media {
    aspect-ratio: 4 / 3;
    border-bottom: 1px solid var(--color-line);
  }
  @media (min-width: 640px) {
    .card-media {
      aspect-ratio: 16 / 10;
    }
  }
  .card-media :global(.preview) {
    transition: transform 1s var(--ease-out-expo);
  }
  .project-card:hover .card-media :global(.preview) {
    transform: scale(1.02);
  }

  /* Feature: side by side on large screens */
  @media (min-width: 1024px) {
    .project-card--feature {
      flex-direction: row;
      min-height: 34rem;
    }
    .project-card--feature .card-media {
      flex: 1.35;
      aspect-ratio: auto;
      border-bottom: 0;
      border-right: 1px solid var(--color-line);
    }
    .project-card--feature .card-body {
      flex: 1;
      padding: 3rem;
    }
    .project-card--horizontal {
      flex-direction: row-reverse;
      min-height: 26rem;
    }
    .project-card--horizontal .card-media {
      flex: 1;
      aspect-ratio: auto;
      border-bottom: 0;
      border-left: 1px solid var(--color-line);
    }
    .project-card--horizontal .card-body {
      flex: 1.05;
    }
  }

  .stretched-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 10;
  }
  .case-arrow {
    background: var(--color-ink);
    color: #fff;
    transition:
      transform 0.5s var(--ease-out-expo),
      background-color 0.3s;
  }
  .project-card:hover .case-arrow {
    background: var(--color-accent);
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transform: none;
    }
  }
</style>
