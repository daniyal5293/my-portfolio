---
/**
 * Illustrated project previews, built in HTML/CSS. They are abstract
 * renderings of each project's idea and are labelled "Illustration" so they
 * are never mistaken for real screenshots. When `project.screenshot` is set,
 * the real image is shown instead.
 */
import type { Project } from '@/data/portfolio';

interface Props {
  project: Project;
  size?: 'card' | 'hero';
  class?: string;
}
const { project, size = 'card', class: className } = Astro.props;
const v = project.preview;
---

<div
  class:list={['preview relative h-full w-full overflow-hidden', `preview--${v}`, size === 'hero' && 'preview--hero', className]}
>
  {
    project.screenshot ? (
      // Real screenshot, framed in a minimal browser window so it is never cropped.
      <>
        <div class="preview-bg absolute inset-0" aria-hidden="true" />
        <div class="preview-stage absolute inset-0 flex items-center justify-center p-[6%]">
          <figure class="shot layer-a w-full overflow-hidden rounded-xl">
            <div class="shot-bar flex items-center gap-1.5 px-3 py-2" aria-hidden="true">
              <span class="tb" />
              <span class="tb" />
              <span class="tb" />
            </div>
            <img
              src={project.screenshot.src}
              alt={project.screenshot.alt}
              loading="lazy"
              decoding="async"
              class="block h-auto w-full"
            />
          </figure>
        </div>
      </>
    ) : (
      <>
        <div class="preview-bg absolute inset-0" aria-hidden="true" />
        <span class="preview-tag label absolute top-4 left-4 z-10">Illustration</span>

        <div class="preview-stage absolute inset-0 flex items-center justify-center p-[8%]" aria-hidden="true">
          {v === 'booking' && (
            <div class="layer-a relative grid w-full max-w-[30rem] grid-cols-[1.25fr_1fr] gap-3">
              <div class="ui-card col-span-1 row-span-2 flex flex-col p-3">
                <div class="video relative flex-1 rounded-lg">
                  <span class="avatar avatar-lg absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2" />
                  <span class="avatar avatar-sm absolute right-2 bottom-2" />
                  <span class="rec absolute top-2 left-2" />
                </div>
                <div class="mt-3 flex items-center gap-2">
                  <span class="dot-btn" />
                  <span class="dot-btn" />
                  <span class="dot-btn dot-btn--end" />
                </div>
              </div>
              <div class="ui-card p-3">
                <p class="ui-label">Mentor</p>
                <div class="mt-2 flex items-center gap-2">
                  <span class="avatar avatar-xs" />
                  <span class="bar w-16" />
                </div>
                <span class="bar mt-2 w-full opacity-60" />
              </div>
              <div class="ui-card layer-b p-3">
                <p class="ui-label">Pick a slot</p>
                <div class="mt-2 grid grid-cols-3 gap-1.5">
                  {Array.from({ length: 6 }, (_, i) => (
                    <span class:list={['slot', i === 4 && 'slot--on']} />
                  ))}
                </div>
                <span class="pay mt-3 block">Book session</span>
              </div>
            </div>
          )}

          {v === 'containers' && (
            <div class="layer-a w-full max-w-[26rem]">
              <div class="compose relative rounded-2xl p-4 pt-8">
                <span class="ui-label absolute top-3 left-4">compose stack</span>
                <div class="grid grid-cols-3 gap-3">
                  {['client', 'api', 'mongodb'].map((name, i) => (
                    <div class:list={['box', `box--${i}`]} style={`--d:${i}`}>
                      <span class="box-lid" />
                      <span class="box-name">{name}</span>
                      <span class="box-stripes" />
                    </div>
                  ))}
                </div>
                <div class="net mt-4 flex items-center justify-between">
                  <span class="net-dot" />
                  <span class="net-line" />
                  <span class="net-dot" />
                  <span class="net-line" />
                  <span class="net-dot" />
                </div>
              </div>
              <div class="term layer-b mt-3 rounded-xl px-4 py-3">
                <span class="term-prompt">$</span> docker compose up
                <span class="caret" />
              </div>
            </div>
          )}

          {v === 'server' && (
            <div class="layer-a relative w-full max-w-[28rem]">
              <div class="term rounded-xl">
                <div class="term-bar flex items-center gap-1.5 px-3 py-2">
                  <span class="tb" />
                  <span class="tb" />
                  <span class="tb" />
                  <span class="ml-2 opacity-60">ubuntu@ec2</span>
                </div>
                <div class="space-y-2 px-4 py-3">
                  <p>
                    <span class="term-prompt">$</span> uname -o
                  </p>
                  <p class="opacity-60">GNU/Linux</p>
                  <p>
                    <span class="term-prompt">$</span> <span class="bar-inline w-24" />
                  </p>
                  <p class="opacity-60">
                    <span class="bar-inline w-32" />
                  </p>
                  <p>
                    <span class="term-prompt">$</span>
                    <span class="caret" />
                  </p>
                </div>
              </div>
              <div class="ui-card sg layer-b absolute -right-2 -bottom-8 w-[58%] p-3 sm:-right-6">
                <p class="ui-label">Inbound rules</p>
                {[0, 1, 2].map((i) => (
                  <div class="mt-2 flex items-center gap-2">
                    <span class:list={['allow', i === 2 && 'allow--deny']} />
                    <span class="bar flex-1" style={`opacity:${0.9 - i * 0.2}`} />
                  </div>
                ))}
              </div>
            </div>
          )}

          {v === 'inbox' && (
            <div class="layer-a relative grid w-full max-w-[30rem] grid-cols-[0.8fr_1.6fr] gap-3">
              <div class="ui-card p-3">
                <span class="pay block">Compose</span>
                {[0, 1, 2, 3].map((i) => (
                  <span class:list={['bar mt-3 block', i === 0 && 'bar--accent']} style={`width:${80 - i * 12}%`} />
                ))}
              </div>
              <div class="ui-card p-2">
                {[0, 1, 2, 3, 4].map((i) => (
                  <div class:list={['mail flex items-center gap-2 rounded-md p-2', i === 1 && 'mail--on']}>
                    <span class:list={['unread', i > 2 && 'opacity-0']} />
                    <span class="avatar avatar-xs" />
                    <span class="flex flex-1 flex-col gap-1">
                      <span class="bar" style={`width:${50 + ((i * 17) % 40)}%`} />
                      <span class="bar opacity-50" style={`width:${70 - ((i * 13) % 30)}%`} />
                    </span>
                  </div>
                ))}
              </div>
              <span class="api-chip layer-b absolute -top-3 right-4">REST API</span>
            </div>
          )}
        </div>
      </>
    )
  }
</div>

<style>
  .preview {
    --p-ink: var(--color-ink);
    background: var(--color-paper-2);
    color: var(--p-ink);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }
  .preview-bg {
    background:
      radial-gradient(120% 90% at 85% 0%, rgb(43 61 255 / 0.16), transparent 55%),
      radial-gradient(90% 80% at 0% 100%, rgb(255 90 31 / 0.1), transparent 60%),
      linear-gradient(180deg, #ecebe6, #e2dfd6);
  }
  .preview-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(12 14 19 / 0.12) 1px, transparent 1px);
    background-size: 18px 18px;
    mask-image: linear-gradient(180deg, #000, transparent 85%);
  }
  .preview--containers .preview-bg {
    background:
      radial-gradient(100% 80% at 50% 0%, rgb(43 61 255 / 0.22), transparent 60%),
      linear-gradient(180deg, #111522, #0b0d14);
  }
  .preview--containers .preview-bg::after {
    background-image: radial-gradient(rgb(255 255 255 / 0.1) 1px, transparent 1px);
  }
  .preview--containers .preview-tag {
    color: rgb(255 255 255 / 0.7);
    border-color: rgb(255 255 255 / 0.2);
    background: rgb(255 255 255 / 0.06);
  }

  .preview-tag {
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: rgb(255 255 255 / 0.55);
    color: var(--color-ink-2);
    font-size: 0.6rem;
    backdrop-filter: blur(6px);
  }

  /* Parallax layers driven by the card's --px / --py (see utils/spotlight.ts) */
  .layer-a,
  .layer-b {
    transition: transform 0.8s var(--ease-out-expo);
  }
  :global([data-spotlight]:hover) .layer-a {
    transform: translate3d(calc(var(--px, 0) * -10px), calc(var(--py, 0) * -10px), 0) scale(1.025);
  }
  :global([data-spotlight]:hover) .layer-b {
    transform: translate3d(calc(var(--px, 0) * -26px), calc(var(--py, 0) * -26px), 0);
  }

  .shot {
    max-width: 44rem;
    background: #fff;
    border: 1px solid rgb(12 14 19 / 0.1);
    box-shadow:
      0 2px 4px rgb(12 14 19 / 0.05),
      0 30px 60px -25px rgb(12 14 19 / 0.4);
  }
  .shot-bar {
    background: #f4f3ef;
    border-bottom: 1px solid rgb(12 14 19 / 0.08);
  }
  .shot-bar .tb {
    background: rgb(12 14 19 / 0.15);
  }

  .ui-card {
    background: rgb(255 255 255 / 0.92);
    border: 1px solid rgb(12 14 19 / 0.08);
    border-radius: 0.85rem;
    box-shadow:
      0 1px 1px rgb(12 14 19 / 0.04),
      0 12px 30px -12px rgb(12 14 19 / 0.25);
  }
  .ui-label {
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
  .bar {
    display: block;
    height: 0.4rem;
    border-radius: 99px;
    background: rgb(12 14 19 / 0.14);
  }
  .bar--accent {
    background: var(--color-accent);
    opacity: 0.8;
  }
  .bar-inline {
    display: inline-block;
    height: 0.4rem;
    border-radius: 99px;
    background: rgb(255 255 255 / 0.35);
    vertical-align: middle;
  }
  .avatar {
    display: block;
    border-radius: 999px;
    background: linear-gradient(140deg, #c7cbe0, #8d94b4);
  }
  .avatar-lg {
    width: 26%;
    aspect-ratio: 1;
  }
  .avatar-sm {
    width: 22%;
    aspect-ratio: 4 / 3;
    border-radius: 0.4rem;
    background: linear-gradient(140deg, #ffb59b, #ff7a4a);
    border: 2px solid #fff;
  }
  .avatar-xs {
    width: 1.2rem;
    height: 1.2rem;
    flex-shrink: 0;
  }
  .video {
    min-height: 8rem;
    background: linear-gradient(160deg, #1b2034, #0c0e13);
  }
  .rec {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 99px;
    background: var(--color-signal);
    box-shadow: 0 0 0 3px rgb(255 90 31 / 0.25);
  }
  .dot-btn {
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 99px;
    background: rgb(12 14 19 / 0.1);
  }
  .dot-btn--end {
    margin-left: auto;
    width: 2.2rem;
    background: var(--color-signal);
  }
  .slot {
    height: 1.1rem;
    border-radius: 0.35rem;
    border: 1px solid rgb(12 14 19 / 0.14);
  }
  .slot--on {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
  .pay {
    padding: 0.4rem 0.6rem;
    border-radius: 99px;
    background: var(--color-ink);
    color: #fff;
    text-align: center;
    font-size: 0.6rem;
  }

  /* Containers */
  .compose {
    border: 1px dashed rgb(255 255 255 / 0.28);
    background: rgb(255 255 255 / 0.03);
  }
  .compose .ui-label {
    color: rgb(255 255 255 / 0.55);
  }
  .box {
    position: relative;
    aspect-ratio: 1 / 1.05;
    border-radius: 0.7rem;
    background: linear-gradient(180deg, #f6f5f1, #d9d7d0);
    padding: 0.55rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    box-shadow: 0 16px 30px -12px rgb(0 0 0 / 0.6);
    transition: transform 0.8s var(--ease-out-expo);
    transition-delay: calc(var(--d) * 60ms);
  }
  .box--1 {
    background: linear-gradient(180deg, #4b5cff, #2b3dff);
    color: #fff;
  }
  .box--2 {
    background: linear-gradient(180deg, #2a2f3d, #141821);
    color: #fff;
  }
  :global([data-spotlight]:hover) .box {
    transform: translateY(-6px);
  }
  .box-lid {
    position: absolute;
    top: 0.5rem;
    left: 0.55rem;
    right: 0.55rem;
    height: 0.3rem;
    border-radius: 99px;
    background: currentColor;
    opacity: 0.2;
  }
  .box-stripes {
    position: absolute;
    top: 1.2rem;
    left: 0.55rem;
    right: 0.55rem;
    height: 35%;
    background: repeating-linear-gradient(90deg, currentColor 0 2px, transparent 2px 7px);
    opacity: 0.12;
  }
  .box-name {
    font-size: 0.62rem;
    font-weight: 600;
  }
  .net-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 99px;
    background: #8f9cff;
  }
  .net-line {
    flex: 1;
    height: 1px;
    margin-inline: 0.3rem;
    background: repeating-linear-gradient(90deg, rgb(255 255 255 / 0.4) 0 4px, transparent 4px 8px);
  }
  .term {
    background: #0b0d14;
    color: #dfe3f2;
    border: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.68rem;
  }
  .preview--containers .term {
    background: rgb(255 255 255 / 0.06);
  }
  .term-bar {
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .tb {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 99px;
    background: rgb(255 255 255 / 0.2);
  }
  .term-prompt {
    color: #8f9cff;
  }
  .caret {
    display: inline-block;
    width: 0.45rem;
    height: 0.85rem;
    vertical-align: middle;
    background: var(--color-signal);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .allow {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 0.3rem;
    background: rgb(11 138 95 / 0.18);
    border: 1px solid var(--color-mint);
    flex-shrink: 0;
  }
  .allow--deny {
    background: rgb(255 90 31 / 0.15);
    border-color: var(--color-signal);
  }

  /* Inbox */
  .mail {
    transition: background-color 0.3s;
  }
  .mail--on {
    background: var(--color-accent-soft);
  }
  .unread {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 99px;
    background: var(--color-accent);
    flex-shrink: 0;
  }
  .api-chip {
    padding: 0.35rem 0.65rem;
    border-radius: 99px;
    background: var(--color-signal);
    color: #fff;
    font-size: 0.6rem;
    box-shadow: 0 10px 20px -8px rgb(255 90 31 / 0.6);
  }

  .preview--hero {
    font-size: 0.8rem;
  }
  @media (max-width: 480px) {
    .preview {
      font-size: 0.6rem;
    }
    .video {
      min-height: 6rem;
    }
  }
</style>
